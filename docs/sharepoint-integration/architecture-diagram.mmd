%% CX Portal — Target Architecture for SharePoint Integration (Azure)
%% Starting point for discussion with IT — open to platform-team preferences.
%% Render at https://mermaid.live or with the Mermaid CLI.

flowchart LR
    subgraph Users["End Users"]
        Hitachi["Hitachi Rail Staff<br/>(Admin, Field, Punch Mgr, Tech)"]
        BART["BART Personnel<br/>(Client / Inspector)"]
    end

    subgraph Edge["Public Edge"]
        CDN["Azure Front Door / CDN<br/>TLS 1.2+, WAF, HSTS"]
    end

    subgraph FE["Frontend (Static SPA)"]
        SPA["index.html + app.js + styles.css<br/>NO secrets · NO service keys<br/>Only public Entra app ID + API base URL"]
    end

    subgraph AzureTenant["Hitachi Azure Tenant (Corporate Subscription)"]
        AAD["Microsoft Entra ID<br/>SSO + MFA + Conditional Access<br/>(Hitachi staff + BART B2B guests)"]
        APIM["Azure API Management<br/>JWT validation · rate limit · audit"]
        subgraph BackendApp["Backend API"]
            API["Node/TS API on App Service<br/>or Container Apps<br/>Validates JWT · enforces RBAC<br/>Owns ALL secrets in memory only"]
            Graph["MS Graph SDK client<br/>(SharePoint document libraries)"]
        end
        KV["Azure Key Vault<br/>SharePoint app secret / cert<br/>DB service-role key<br/>Mail-delivery / signing keys"]
        MI["Managed Identity<br/>(App Service → Key Vault, Graph, DB)"]
        AzPG[("Azure Database for PostgreSQL<br/>Flexible Server<br/>Schema + RLS migrated from Supabase<br/>test_items / results / punch_items /<br/>audit_log / db_change_log")]
        LOG["Azure Monitor + Log Analytics<br/>Defender for Cloud · Sentinel"]
    end

    subgraph M365["Microsoft 365 (Corporate Tenant)"]
        SP["SharePoint Online<br/>BART CBTC Project ▸ Commissioning subsite<br/>Document Libraries:<br/>• Punch photos (before / after)<br/>• Daily logs<br/>• Test reports (CDRL)<br/>• Look-ahead workbooks"]
    end

    Hitachi -- "HTTPS" --> CDN
    BART -- "HTTPS" --> CDN
    CDN -- "Static assets" --> SPA

    Hitachi -- "Interactive SSO" --> AAD
    BART -- "Interactive SSO (guest)" --> AAD
    AAD -- "ID + access token (JWT)" --> SPA

    SPA -- "HTTPS + Bearer JWT<br/>/api/*" --> CDN
    CDN -- "Reverse proxy" --> APIM
    APIM -- "Validated JWT" --> API

    API -- "Reads secrets via MI" --> KV
    API -- "App-only / OBO token" --> Graph
    Graph -- "Graph REST<br/>(files, sites, drives)<br/>scope: Sites.Selected" --> SP

    API -- "SQL over TLS<br/>(service role, server-side only)" --> AzPG

    API -- "Structured logs / metrics" --> LOG
    APIM -- "Access logs" --> LOG
    AAD -- "Sign-in + audit logs" --> LOG

    classDef secret fill:#fde2e2,stroke:#c53030,stroke-width:1px,color:#742a2a;
    classDef public fill:#e6f4ff,stroke:#1d4ed8,stroke-width:1px,color:#1e3a8a;
    classDef trusted fill:#e6ffed,stroke:#15803d,stroke-width:1px,color:#14532d;

    class SPA public;
    class KV,MI,API,Graph secret;
    class AAD,APIM,SP,AzPG,LOG trusted;
